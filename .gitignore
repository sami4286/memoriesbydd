# Deliberately minimal.
#
# The project content is tracked on purpose. Only generated output, dependencies
# and local machine/editor state belong here.

# Dependencies and generated builds
node_modules/
dist/
_deploy/dist/
.vite/

# OS cruft
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editor / IDE local state
.vscode/
.idea/
*.swp
*~

# Local scratch only
*.log

# Secrets and local service credentials
.env
.env.*
!.env.example
*.pem
*.key
